# ==========================================
# VARIÁVEIS DE AMBIENTE - RAIZ DO PROJETO
# ==========================================

# Base de Dados (Utilize o padrão abaixo se for usar o Docker Compose incluso)
DATABASE_URL=postgresql+asyncpg://eventify_user:eventify_password@localhost:5432/eventify_events

# Credenciais da API do TMDb
TMDB_API_KEY=sua_chave_da_api_tmdb_aqui
TMDB_READ_TOKEN=seu_token_de_leitura_tmdb_aqui

# Base URL da API do TMDB
TMDB_BASE_URL=https://api.themoviedb.org/3

# Autenticação JWT
JWT_SECRET_KEY=gere_uma_string_aleatoria_segura_aqui
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# Criptografia simétrica Fernet para os tokens do QR Code (Deve ser uma string base64 url-safe de 32 bytes)
FERNET_SECRET=gere_uma_string_base64_de_32_bytes_aqui

# Stripe (simulado — use a chave de teste real se tiver criado uma conta)
STRIPE_SECRET_KEY=sk_test_sua_chave_secreta_do_stripe_aqui
STRIPE_WEBHOOK_SECRET=whsec_seu_segredo_de_webhook_do_stripe_aqui

# URL do Front-End (ambiente de desenvolvimento local)
FRONTEND_URL=http://localhost:5173

# URL do Back-End (necessário expor via ngrok para testar webhooks do Stripe localmente)
BACKEND_URL=https://sua-url-do-ngrok.ngrok-free.dev
